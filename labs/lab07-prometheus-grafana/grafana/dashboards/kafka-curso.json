  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Salud del clúster",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
